# Copia este archivo como ".env" (en Windows: copy env.example .env) y completa los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore). En CI se usan GitHub Secrets.
BASE_URL=https://www.casinoatlanticcity.com/
# La cuenta del reto (Testcalimaco35) quedó bloqueada por intentos fallidos.
# El equipo evaluador entregó cuentas alternativas: Testcalimaco34 y Testcalimaco36.
CASINO_USER=Testcalimaco34
CASINO_PASSWORD=Testcalimaco34

# Opcionales
# BROWSER=chromium        # chromium | firefox | webkit
# CHANNEL=chrome          # usa el Google Chrome instalado en vez de Chromium
# HEADLESS=false          # por defecto: headless en CI, con ventana en local
# SLOWMO=500              # ms entre acciones, para ver la ejecución en cámara lenta
