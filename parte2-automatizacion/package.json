{
  "name": "atlantic-city-login-e2e",
  "version": "1.0.0",
  "description": "Pregunta 10 - Automatización del login de Casino Atlantic City con Playwright + Cucumber (BDD) + TypeScript",
  "private": true,
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:visual": "cross-env HEADLESS=false SLOWMO=500 cucumber-js",
